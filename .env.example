# ─────────────────────────────────────────────────────────────────────────────
# Used-Car Sales Lead-Gen Platform — environment variables
# Copy to .env.local and fill in. Never commit real secrets (.env* is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (NEW project — create at supabase.com, then paste its keys here) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin bootstrap (comma-separated allowlist is a fallback; admin_roles is primary) ──
ADMIN_EMAIL=
ADMIN_EMAIL_ALLOWLIST=

# ── Geo restriction (edge middleware; see src/lib/security/geo-restriction.ts) ──
# The site is served only to the countries listed below. Enforced in
# middleware.ts from the CDN-injected country header, so it cannot be spoofed
# by a client. Leave everything unset for the default AU + IN policy.
#
# Kill switch — set to "false" to disable geo-restriction entirely.
GEO_RESTRICTION_ENABLED=
# Comma-separated ISO 3166-1 alpha-2 codes. Defaults to "AU,IN" when unset.
GEO_ALLOWED_COUNTRIES=
# Only set to "true" when self-hosting behind a geo-aware proxy that injects
# x-vercel-ip-country / cf-ipcountry / x-geo-country AND strips the client's own
# copy of it. On Vercel this is detected automatically — leave it unset there.
GEO_TRUST_PROXY_HEADERS=
# Non-production only: simulate a visitor country locally, e.g. GEO_DEV_COUNTRY=US
GEO_DEV_COUNTRY=

# ── Anti-spam: Cloudflare Turnstile ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set to "true" in non-prod to skip Turnstile verification during local dev.
TURNSTILE_SKIP=

# ── Rate limiting: Redis (Upstash-compatible). Falls back to in-memory if unset. ──
REDIS_URL=
# Salt for hashing lead IP addresses (never store raw IPs).
IP_HASH_SECRET=

# ── Transactional email: SMTP (nodemailer). No-ops if unset. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
REPLY_TO_EMAIL=
CONTACT_EMAIL_TO=

# ── Search: Typesense (optional; search degrades gracefully if unset) ──
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=
# Auth token the search-index-worker edge function expects.
WORKER_API_KEY=

# ── Maps (VDP / contact / location pages) ──
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Cron auth (lead anonymization / reminders) ──
CRON_SECRET=

# ── Analytics / SEO verification (optional) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─────────────────────────────────────────────────────────────────────────────
# Syndication module (docs/syndication/). Sprint 1 uses NONE of these — they are
# declared ahead of the sync engine so the contract is reviewable. Leave unset.
# ─────────────────────────────────────────────────────────────────────────────
# Master safety switch. Live pushes require this AND a non-development
# environment; the default (unset/false) is dry-run. Never true outside prod.
SYNDICATION_LIVE_PUSH=false
# Volume guard: abort publishing if the item count drops by more than this
# fraction vs the last successful run. A truncated feed deletes the dealer's
# listings at the channel, so this is a safety mechanism, not a tuning knob.
FEED_MAX_DROP_PCT=0.20
FEED_STORAGE_BUCKET=
# High-entropy secret used to derive per-dealer, per-channel feed URL tokens.
FEED_SIGNING_SECRET=
# Envelope-encryption key for stored OAuth tokens. Tokens are never plaintext.
CREDENTIAL_ENCRYPTION_KEY=

# Google Vehicle Ads (Merchant Center)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_MERCHANT_CENTER_ID=

# Meta Marketplace / WhatsApp catalogue
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CATALOG_ID=

# TikTok display sync (embeds on the VDP; no commerce, no listing push)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Call tracking numbers for per-channel lead attribution
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Critical sync failures (volume guard tripped, token refresh failed)
ALERT_WEBHOOK_URL=

# ── Social links (optional; rendered in footer) ──
NEXT_PUBLIC_SOCIAL_FACEBOOK_URL=
NEXT_PUBLIC_SOCIAL_INSTAGRAM_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN_URL=
NEXT_PUBLIC_SOCIAL_X_URL=
